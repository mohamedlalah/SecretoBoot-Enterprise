function New-SbAndroidAccessibleManifest{
 [CmdletBinding()]param([Parameter(Mandatory)][string]$Level1ManifestDigest,[bool]$FeatureGateState=$false,[bool]$ExplicitConsent=$false,[bool]$NonElevated=$false,[ValidateSet('Passed','Failed','NotRun')][string]$PlatformCheck='NotRun')
 [pscustomobject][ordered]@{SchemaVersion='v9androidaccessibleexecution1';PackageRevision='Android-Initrd-Runtime-MVP.1';FeatureGateState=$FeatureGateState;ExplicitConsent=$ExplicitConsent;PlatformCheck=$PlatformCheck;NonElevated=$NonElevated;Level1ManifestDigest=$Level1ManifestDigest;DynamicDetectedSystems=$true;MaximumPartitionCandidates=4096;MaximumInspectableVolumes=256;MaximumFilesPerVolume=40;MaximumAggregateReadBytesPerVolume=262144;MaximumTextFileBytes=65536;MaximumInitrdCompressedBytes=33554432;MaximumInitrdDecompressedBytes=134217728;MaximumInitrdArchiveEntries=4096;MaximumInitrdEntryBytes=33554432;TimeoutMillisecondsPerVolume=10000;AllowedFilesystems=@('FAT32','exFAT','NTFS');ApprovedPathSetVersion='android-initrd-runtime-exact-paths-v1';OrdinaryVolumeReadAccess=$true;DirectoryEnumeration=$false;EfiAccess=$false;Mounts=$false;DriveLetterAssignment=$false;Elevation=$false;Writes=$false;BcdAccess=$false;NvramAccess=$false;SecureBootAccess=$false;BootOrderAccess=$false;PartitionWrites=$false;Network=$false;RefindAccess=$false}
