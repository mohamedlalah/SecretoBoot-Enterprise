function Get-SbAndroidAccessibleManifestDigest{[CmdletBinding()]param([Parameter(Mandatory)][object]$Manifest);$a=[Security.Cryptography.SHA256]::Create();try{$h=$a.ComputeHash([Text.Encoding]::UTF8.GetBytes(($Manifest|ConvertTo-Json -Depth 20 -Compress)))}finally{$a.Dispose()};[BitConverter]::ToString($h).Replace('-','').ToLowerInvariant()}
