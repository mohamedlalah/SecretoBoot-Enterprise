function Initialize-SbWindowsAndroidEvidenceAdapter{[CmdletBinding()]param();if($null-ne('SecretoBoot.V9.WindowsAndroidEvidence.AndroidEvidenceAdapter'-as[type])){return $true};$source=Join-Path $PSScriptRoot 'Native/SecretoBoot.WindowsAndroidEvidence.Native.cs';if(-not[IO.File]::Exists($source)){throw 'ANDROID_EVIDENCE_NATIVE_SOURCE_MISSING'};Add-Type -Path $source -ErrorAction Stop;return $null-ne('SecretoBoot.V9.WindowsAndroidEvidence.AndroidEvidenceAdapter'-as[type])}
function Invoke-SbWindowsAndroidEvidenceInspection{[CmdletBinding()]param([Parameter(Mandatory)][guid]$VolumeGuid,[Parameter(Mandatory)][ValidatePattern('^report:partition:[0-9a-f]{20}$')][string]$PartitionId,[Parameter(Mandatory)][ValidateSet('FAT32','exFAT','NTFS')][string]$Filesystem,[Parameter(Mandatory)][switch]$EnableAndroidEvidence,[Parameter(Mandatory)][switch]$GrantExplicitConsent);$null=Initialize-SbWindowsAndroidEvidenceAdapter;$request=[SecretoBoot.V9.WindowsAndroidEvidence.AndroidVolumeRequest]::new();$request.FeatureEnabled=$EnableAndroidEvidence.IsPresent;$request.ExplicitConsent=$GrantExplicitConsent.IsPresent;$request.RequireNonElevated=$true;$request.VolumeGuid=$VolumeGuid.ToString('D');$request.PartitionId=$PartitionId;$request.ExpectedFilesystem=$Filesystem;return [SecretoBoot.V9.WindowsAndroidEvidence.AndroidEvidenceAdapter]::Inspect($request)}
Export-ModuleMember -Function Initialize-SbWindowsAndroidEvidenceAdapter,Invoke-SbWindowsAndroidEvidenceInspection
